# Optional. The public model and dataset normally download without a token, but
# authenticated Hugging Face access avoids anonymous rate limits.
HF_TOKEN=

# Required only for Notebook 01's NVIDIA-hosted Lightning and Ultra NVFP4 baselines.
# Prefer hidden notebook input on shared machines; never commit a real key.
NVIDIA_API_KEY=

# Optional API configuration selection. With neither variable set, Notebook 01
# auto-loads config/api.local.toml when it exists, otherwise public defaults.
# NEMOTRON_API_PROFILE=public  # auto, public, or local
# NEMOTRON_API_CONFIG=/secure/path/to/api.internal.toml

# Optional direct overrides. Set NEMOTRON_API_PROFILE_NAME when using these so
# private artifacts have a meaningful prefix; otherwise the prefix is "custom".
# NEMOTRON_API_PROFILE_NAME=internal
# NEMOTRON_API_BASE_URL=https://internal-endpoint.example/v1
# NEMOTRON_API_REQUESTS_PER_MINUTE=120
# NEMOTRON_API_TIMEOUT_SECONDS=90
# NEMOTRON_API_LIGHTNING_MODEL_ID=internal/lightning-model-id
# NEMOTRON_API_LIGHTNING_MODEL_VARIANT=internal-lightning-variant
# NEMOTRON_API_ULTRA_MODEL_ID=internal/ultra-model-id
# NEMOTRON_API_ULTRA_MODEL_VARIANT=internal-ultra-variant

# Launchable setup controls.
NEMOTRON_MODEL_PROFILE=nano9b_workshop
NEMOTRON_PREFETCH_MODEL=0
NEMOTRON_JUPYTER_PORT=8889

# Optional GPU-count controls inside the container. Nano requires one PEFT rank;
# the Lightning advanced notebook defaults to two. vLLM defaults to one GPU.
# NEMOTRON_PEFT_NUM_GPUS=1
# NEMOTRON_INFERENCE_GPUS=1
